APP_NAME=CloudGuardian
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./cloudguardian.db
AWS_ENABLED=false
AWS_REGION=ap-south-1
AWS_DEFAULT_INSTANCE_ID=
AWS_SSM_DOCUMENT=AWS-RunShellScript
AWS_SSM_TIMEOUT_SECONDS=60
LLM_ENABLED=false
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAG_ENABLED=true
VECTOR_STORE=local
API_KEY=change-me
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
